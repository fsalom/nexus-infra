# Copia a .env y ajusta.  NO subas .env al repo.
# OJO: en un .env el comentario en la misma línea NO se descarta, pasa a formar
# parte del valor. Los comentarios van siempre en su propia línea.
# (En despliegue por pipeline, esto va como secret INFRA_ENV.)

# Dominio base. Subdominios: auth.$DOMAIN, gastos.$DOMAIN, workout.$DOMAIN (DNS -> servidor).
DOMAIN=midominio.com

# Correo para los certificados TLS (Let's Encrypt).
ACME_EMAIL=tucorreo@ejemplo.com

# --- Postgres compartido (BBDD: microworkout, gastos, auth) ---
# Usa un password SIN caracteres especiales (hex): va dentro de la URL de conexión.
POSTGRES_USER=nexus
# genéralo con: openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esto

# --- SSO (nexus-auth) ---
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=cambia-esta-contraseña

# --- gastos ---
# El login lo pone el SSO; solo hace falta el token del cron.
# genéralo con: openssl rand -hex 24
GASTOS_CRON_TOKEN=

# IA de gastos (opcional). Vale cualquier proveedor que hable /v1/chat/completions:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://TU_HOST:11434/v1   (ojo: 'localhost' NO vale, el contenedor no
#                                          alcanza el host; usa una IP o un servicio
#                                          del propio compose)
# Con estas tres se activa SOLO la sugerencia de categorías en «Clasificar comercios»,
# que envía comercio y concepto: nunca importes, saldos ni identidades.
GASTOS_AI_BASE_URL=
GASTOS_AI_MODEL=
# vacío si el proveedor no la pide (Ollama local)
GASTOS_AI_API_KEY=

# Interruptor APARTE para el Asistente (la pestaña de chat). Ponlo a 1 solo si aceptas
# que salgan IMPORTES: medias mensuales, gasto por categoría, presupuestos, patrimonio y
# cartera, siempre agregados. Nunca movimientos individuales, contrapartes, nombres de
# personas ni números de cuenta. Puedes ver el paquete exacto en /api/ai/context antes
# de usarlo. No comparte interruptor con lo de arriba justamente por esto.
# ponlo a 1 para activarlo
GASTOS_AI_PLANNER=

# --- microworkout ---
WORKERS=2
# Ruta al .env de microworkout (SECRET_KEY, ALLOWED_HOSTS…; los POSTGRES_* los pone la infra).
# WORKOUT_ENV=../python-microworkout/.env
